# MailTrace AI — Backend Environment Configuration
# Copy this file to .env in the backend directory to enable live third-party integrations.

# Server Configuration
PORT=8000
HOST=127.0.0.1

# VirusTotal API Key (Optional)
# Sign up at https://www.virustotal.com to obtain a free API key for real-time IP/URL reputation checks
VIRUSTOTAL_API_KEY=

# IMAP Email Monitoring Configuration (Optional)
# Used for real-time inbox scanning via background watcher
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_app_password
