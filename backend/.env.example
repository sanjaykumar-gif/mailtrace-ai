# ====================================================================
# MailTrace AI — Backend Environment Configuration Template
# ====================================================================

PORT=8000
HOST=127.0.0.1
APP_ENV=production
DEBUG=false

# Supabase Cloud Database (PostgreSQL) — Free at https://supabase.com
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# External Threat Intelligence (Free tier: https://www.virustotal.com)
VIRUSTOTAL_API_KEY=
VT_API_KEY=

# AbuseIPDB (Free tier: https://www.abuseipdb.com)
ABUSEIPDB_API_KEY=

# Google Gemini (Free tier: https://aistudio.google.com)
GEMINI_API_KEY=

# Live IMAP Mailbox Sentinel
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASS=your_16_char_app_password
IMAP_SSL=true
IMAP_POLL_INTERVAL=15

# Polygon Amoy Testnet RPC (Free public endpoint)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
